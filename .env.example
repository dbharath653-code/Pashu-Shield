# ==============================================================================
# PASHU-SHIELD ENVIRONMENT CONFIGURATION
# Copy to .env for local deployment
# ==============================================================================

# Primary Database (PostgreSQL with PostGIS for production; SQLite fallback in dev)
DATABASE_URL=postgresql+asyncpg://pashu_user:pashu_password@localhost:5432/pashu_shield
# For local dev without PostgreSQL installed:
# DATABASE_URL=sqlite+aiosqlite:///./pashu_shield.db

# Redis Caching & Realtime Pub/Sub
REDIS_URL=redis://localhost:6379/0

# JWT Security Credentials (never commit production secrets)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-32chars
JWT_REFRESH_SECRET=replace-with-a-different-cryptographically-secure-random-secret-key-32chars

# Google Maps API Key (Used for production GIS layers, marker clustering & route navigation)
# If left empty, Pashu-Shield automatically falls back to the embedded Leaflet GIS map.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Translation Provider (options: 'local', 'google', 'azure')
TRANSLATION_PROVIDER=local
TRANSLATION_API_KEY=

# SMS Notification Provider (options: 'mock', 'fast2sms', 'twilio')
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=PASHU

# WhatsApp Business API Provider (options: 'mock', 'whatsapp_cloud_api')
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# External Government Surveillance & ICAR-NIVEDI NADRES Adapters
# Official access requires authorized institutional credentials
NADRES_API_URL=https://nadres.res.in/api/v1
NADRES_API_KEY=
GOVERNMENT_API_URL=https://dahd.nic.in/api/v1
GOVERNMENT_API_KEY=
LAB_API_URL=https://diseasediagnostics.nic.in/api/v1
LAB_API_KEY=
WEATHER_API_URL=https://api.open-meteo.com/v1

# Frontend API Base URL (leave empty when Vite dev proxy forwards to http://127.0.0.1:8000)
VITE_API_BASE_URL=
ML_BACKEND_URL=http://127.0.0.1:8000
