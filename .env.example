# Base URL of the FastAPI ML service (ml-backend/) used by the AI Early Warning screen.
# Leave empty/undefined to call the same origin at "/api" (development proxy or a
# reverse proxy in production). When the endpoint is unreachable, the app automatically
# falls back to the on-device prediction engine.
# VITE_API_BASE_URL=https://ml-api.example.org/api

# Host the app under a sub-path (e.g. GitHub Pages project sites) by exporting this
# variable at build time:  VITE_BASE_PATH=/Pashu-Shield/ npm run build
# VITE_BASE_PATH=/

# Target used by the Vite dev/preview proxy for "/api" (dev only).
# ML_BACKEND_URL=http://127.0.0.1:8000
