# ==============================================================================
# PASHU-SHIELD ENVIRONMENT CONFIGURATION — placeholders only, never commit real values.
# Copy to .env for local use. Production refuses to start with insecure settings
# (see backend/config.py::validate_for_environment).
# ==============================================================================

# development | staging | test | production
ENVIRONMENT=development
# live (real data only) | hybrid (real + labelled demo) | demo. Production requires live.
DATA_MODE=hybrid

# --- Database -------------------------------------------------------------------
# Production: PostgreSQL + PostGIS, schema managed by `alembic upgrade head`.
DATABASE_URL=sqlite+aiosqlite:///./pashu_shield.db
# DATABASE_URL=postgresql+asyncpg://pashu_user:CHANGE_ME@localhost:5432/pashu_shield
# Only honoured outside production (create_all for local dev convenience)
AUTO_CREATE_SCHEMA=true

# --- Demo data (never in production) -------------------------------------------
SEED_DEMO_DATA=false
ENABLE_DEMO_LOGIN=false
DEMO_USER_PASSWORD=

# --- Auth -------------------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"  (two DIFFERENT values)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=pashu-shield
JWT_AUDIENCE=pashu-shield-clients
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- HTTP ------------------------------------------------------------------------
# Comma-separated explicit origins (no '*' in production)
CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=2097152

# --- Jobs / rate limiting ---------------------------------------------------------
# inline (API process polls jobs; dev) | worker (separate `python -m backend.worker`; required in production)
JOB_BACKEND=inline
# memory (single process) | redis (required in production)
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# --- Uploads ------------------------------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=10485760
CLAMAV_HOST=
CLAMAV_PORT=3310
# Dev only; ignored in production (uploads are refused when no scanner is reachable)
ALLOW_UNSCANNED_UPLOADS=
VOICE_RECORDING_RETENTION_DAYS=30

# --- Dispatch / routing -------------------------------------------------------------
DISPATCH_ACCEPT_TIMEOUT_MINUTES=30
# none (ETA_UNAVAILABLE, straight-line distance only) | osrm
ROUTING_PROVIDER=none
OSRM_URL=

# --- Maps (frontend) -------------------------------------------------------------------
# Empty => embedded Leaflet map
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- External surveillance (authorised institutional access only) ------------------
# Leave empty until an official API contract + credentials are issued; the UI then shows
# CONFIGURATION_REQUIRED instead of placeholder numbers.
NADRES_API_URL=
NADRES_API_KEY=
GOVERNMENT_API_URL=
GOVERNMENT_API_KEY=
# none | dev_mock (development only)
LAB_PROVIDER=none
LAB_API_URL=
LAB_API_KEY=
# open_meteo (public, keyless) | none
WEATHER_PROVIDER=open_meteo
WEATHER_API_URL=https://api.open-meteo.com/v1

# --- Notifications -----------------------------------------------------------------------
# none | dev_log (development only) | fast2sms
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=PASHU
# JSON map template->DLT template id (India DLT compliance)
SMS_DLT_TEMPLATE_IDS=
# none | dev_log | whatsapp_cloud_api
WHATSAPP_PROVIDER=none
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0
IVR_PROVIDER=none
IVR_WEBHOOK_SECRET=

# --- Telephony / inbound IVR (Twilio) --------------------------------------------------------
# twilio (real Twilio number + webhooks) | mock (MockTelephonyProvider for demo/tests)
TELEPHONY_PROVIDER=twilio
# From your Twilio console (Account SID / Auth Token). NEVER commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional extra shared secret header for non-Twilio callers of the webhook (X-Webhook-Secret).
TWILIO_WEBHOOK_SECRET=
# Validate X-Twilio-Signature on every voice webhook (keep true outside local development).
TWILIO_VALIDATE_WEBHOOK=true
# Public https base URL Twilio reaches during development, e.g. https://your-ngrok-domain.ngrok-free.app
# Required for real inbound calls (signature + TwiML action URLs).
PUBLIC_API_BASE_URL=

# IVR flow
IVR_ENABLED=true
IVR_DEFAULT_LANGUAGE=en
# Veterinarian outbound dial behaviour (PATH A)
IVR_VET_TIMEOUT_SECONDS=20
IVR_MAX_VET_ATTEMPTS=3
# Recording of farmer<->vet bridged calls (off by default)
CALL_RECORDING_ENABLED=false
# Safe "Simulate Incoming Farmer Call" dashboard action (uses MockTelephonyProvider; refused in production)
DEMO_MODE=false

# --- Speech-to-text / AI call summary (optional; recordings only processed when set) ---------
# none/unset (recordings stay untranscribed) | openai_whisper
STT_PROVIDER=
STT_API_KEY=
# none/unset (deterministic template summary) | openai
AI_SUMMARY_PROVIDER=
AI_SUMMARY_API_KEY=

# --- Translation ---------------------------------------------------------------------------
# local (glossary fallback) | google
TRANSLATION_PROVIDER=local
TRANSLATION_API_KEY=

# --- Frontend ------------------------------------------------------------------------------
# Empty => relative /api (Vite dev proxy forwards to the backend)
VITE_API_BASE_URL=
